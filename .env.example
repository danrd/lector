# Copy to .env and fill in what you actually use - never commit .env itself
# (already in .gitignore).

# Required only if you use llm_kit.llm_runtime.OpenRouterRunner (hosted
# models via OpenRouter) - read directly via os.environ.get() in
# llm_kit/llm_runtime.py.
OPENROUTER_API_KEY=

# Required only if you use llm_kit.llm_run.run_llm_over_tasks (wandb
# logging/checkpointing). Not read directly by llm_kit - the wandb library
# itself picks this up, or run `wandb login` once instead.
WANDB_API_KEY=

# Required only if you use lector.tts_runtime.OpenAITTSRunner (hosted TTS
# fallback) without passing api_key/client explicitly. The local default,
# PiperRunner, needs no key at all.
OPENAI_API_KEY=

# Required only for CometAPI (lector-read's default backend: speech via
# ElevenLabs presets / seed_audio voice cloning, plus the chat model that
# reads formulas). COMETAPI_KEY - the name CometAPI's own docs use - works too.
COMET_API_KEY=
